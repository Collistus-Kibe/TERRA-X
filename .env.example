# ==============================================================================
# TERRA-X Environment Configuration (.env.example)
# NASA Space Apps 2026 - Functional Planetary Analog Discovery Engine
# ==============================================================================
# Copy this file to .env and supply your agency credentials.
# Connectors run in graceful fallback mode if live network or tokens are absent.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
TERRAX_HOST=127.0.0.1
TERRAX_PORT=8000
TERRAX_DEBUG=true
TERRAX_CLIENT_ID="TERRA-X-SpaceApps-2026/1.0"
LOG_LEVEL=INFO
TERRAX_CACHE_DIR="./data/cache"

# ------------------------------------------------------------------------------
# 2. NASA EARTHDATA LOGIN (EDL) & CMR / HARMONY
# Used for: ECOSTRESS V003, EMIT, OPERA RTC-S1, HLS, MODIS, SMAP, IMERG, MERRA-2
# Portal: https://urs.earthdata.nasa.gov
# ------------------------------------------------------------------------------
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_TOKEN=your_earthdata_bearer_token
# CMR Endpoint overrides if needed (default: https://cmr.earthdata.nasa.gov/search)
CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search

# ------------------------------------------------------------------------------
# 3. EU COPERNICUS DATA SPACE ECOSYSTEM (CDSE)
# Used for: COP-DEM GLO-30 COG, Sentinel-1 RTC GAMMA0_TERRAIN, CLMS
# Modern v1 Endpoint: https://stac.dataspace.copernicus.eu/v1
# Portal: https://dataspace.copernicus.eu
# ------------------------------------------------------------------------------
CDSE_CLIENT_ID=your_cdse_keycloak_client_id
CDSE_CLIENT_SECRET=your_cdse_client_secret
CDSE_USERNAME=your_cdse_login_email
CDSE_PASSWORD=your_cdse_login_password
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# ------------------------------------------------------------------------------
# 4. USGS LANDSATLOOK & EARTHEXPLORER STAC
# Used for: Landsat Collection 2 Level-2 Surface Reflectance (SR) & Temperature (ST)
# Portal: https://landsatlook.usgs.gov/stac-server
# ------------------------------------------------------------------------------
USGS_STAC_URL=https://landsatlook.usgs.gov/stac-server
USGS_API_KEY=your_usgs_eros_token

# ------------------------------------------------------------------------------
# 5. ESA PLANETARY SCIENCE ARCHIVE (PSA) EPN-TAP
# Used for: Mars Express HRSC DTMs & OMEGA Mineralogy
# TAP Service: https://psa.esa.int/psa-tap/tap
# ------------------------------------------------------------------------------
PSA_TAP_URL=https://psa.esa.int/psa-tap/tap

# ------------------------------------------------------------------------------
# 6. ASIA CONNECTORS: JAXA & ISRO PRADAN
# Used for: AW3D30 30m DSM, PALSAR 25m, GSMaP, Chandrayaan TMC
# Note: ISRO PRADAN requires manual-in-the-loop authorization.
# ------------------------------------------------------------------------------
JAXA_API_KEY=your_jaxa_gportal_key
HIMAWARI_NON_PROFIT_ACKNOWLEDGED=true
ISRO_PRADAN_USER=your_isro_pradan_username
ISRO_PRADAN_TOKEN=your_isro_pradan_token

# ------------------------------------------------------------------------------
# 7. CANADIAN SPACE AGENCY (CSA)
# Used for: RADARSAT Constellation Mission (RCM) & RADARSAT-1 Open Data
# ------------------------------------------------------------------------------
CSA_EODMS_URL=https://www.eodms-sgdot.nrcan-rncan.gc.ca

# ------------------------------------------------------------------------------
# 8. META CLOUD AI COPILOT & TOKEN EFFICIENCY
# Meta Muse Models:
# - muse-wonder-1.0 (RECOMMENDED: Frontier agentic reasoning, highest benchmark score, optimal token efficiency)
# - muse-spark-1.3  (Frontier multimodal reasoning with 1M context window and rapid inference speed)
# - muse-wonder-full-1.0 (High-capacity tier for deeply layered aerospace and planetary systems design)
# ------------------------------------------------------------------------------
META_API_KEY=your_meta_cloud_api_key
AI_API_BASE_URL=https://api.meta.com/v1
AI_MODEL=muse-wonder-1.0
AI_MAX_TOKENS=350
AI_TEMPERATURE=0.2

